# Test environment variables
ENVIRONMENT=test

# Database (uses sqlite in-memory for tests)
DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis (uses redis instance, can be mocked in tests)
REDIS_URL=redis://redis:6379/1

# JWT
JWT_SECRET_KEY=test-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_TITLE=Cards Against Humanity Clone
API_VERSION=0.1.0-test
API_DESCRIPTION=Cross-platform multiplayer card game (test)

# CORS
CORS_ORIGINS=["http://localhost:8000"]

# Server
HOST=0.0.0.0
PORT=8000
