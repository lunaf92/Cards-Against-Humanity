# Development environment variables
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://cah_user:cah_password@postgres:5432/cah_dev

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# API
API_TITLE=Cards Against Humanity Clone
API_VERSION=0.1.0
API_DESCRIPTION=Cross-platform multiplayer card game

# CORS
# JSON list. Include every origin the web frontend is served from (Vite dev server
# is :5173, `vite preview` is :4173); behind a reverse proxy add its public origin.
CORS_ORIGINS=["http://localhost:8000", "http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:4173", "http://localhost:19000"]

# Seconds a disconnected player may reconnect before being removed from the room
RECONNECT_WINDOW_SECONDS=60

# Server
HOST=0.0.0.0
PORT=8000
