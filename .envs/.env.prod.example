# Copy to .envs/.env.prod and fill in. Never commit the real file.
#   cp .envs/.env.prod.example .envs/.env.prod

# Where the site is served (see frontend/deploy/Caddyfile):
#   your domain, e.g. cah.example.com -> automatic HTTPS (forward ports 80 and 443)
#   :80                               -> plain HTTP on your LAN/public IP
SITE_ADDRESS=:80

# Long random strings. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=change-me

# Seconds a dropped player may take to come back before being removed from the game.
# Generous for casual games where phones lock or switch apps.
RECONNECT_WINDOW_SECONDS=180

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
