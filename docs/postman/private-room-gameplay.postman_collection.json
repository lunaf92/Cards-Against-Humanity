                    ]
                },
                {
                    "name": "05 Get Room Details (Confirm All 3 Players)",
                    "request": {
                        "method": "GET",
                        "header": [
                            { "key": "Authorization", "value": "Bearer {{u1_access}}" }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/rooms/{{room_id}}",
                            "host": [ "{{baseUrl}}" ],
                            "path": [ "rooms", "{{room_id}}" ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Room fetch returns 200\", function () {",
                                    "  pm.response.to.have.status(200);",
                                    "});",
                                    "const body = pm.response.json();",
                                    "pm.test(\"Exactly 3 players, room still in lobby\", function () {",
                                    "  pm.expect(body.players.length).to.eql(3);",
                                    "  pm.expect(body.status).to.eql(\"lobby\");",
                                    "});",
                                    "const host = body.players.find(p => p.join_order === 1);",
                                    "if (host) pm.environment.set(\"host_player_id\", host.player_id);"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ]
                }
            ]
