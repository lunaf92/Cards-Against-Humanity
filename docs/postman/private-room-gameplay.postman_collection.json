                {
                    "name": "03 Create Private Room (Host)",
                    "request": {
                        "method": "POST",
                        "header": [
                            { "key": "Content-Type", "value": "application/json" },
                            { "key": "Authorization", "value": "Bearer {{u1_access}}" }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"password\": \"letmein\",\n  \"max_players\": 10,\n  \"winning_score\": 3,\n  \"round_timer_seconds\": 90,\n  \"card_pool_mode\": \"default_only\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/rooms",
                            "host": [ "{{baseUrl}}" ],
                            "path": [ "rooms" ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Create room returns 201\", function () {",
                                    "  pm.response.to.have.status(201);",
                                    "});",
                                    "const body = pm.response.json();",
                                    "pm.test(\"Room is a private lobby\", function () {",
                                    "  pm.expect(body.room_kind).to.eql(\"private\");",
                                    "  pm.expect(body.status).to.eql(\"lobby\");",
                                    "});",
                                    "pm.environment.set(\"room_id\", body.id);",
                                    "pm.environment.set(\"room_code\", body.code);",
                                    "console.log(\"Room code:\", body.code, \"Room id:\", body.id);"
                                ],
