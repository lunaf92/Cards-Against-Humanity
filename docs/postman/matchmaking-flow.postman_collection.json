                            "});",
                            "const body = pm.response.json();",
                            "pm.test(\"Match should be created\", function () {",
                            "  pm.expect(body.matched_room_id).to.not.eql(null);",
                            "});",
                            "pm.environment.set(\"matched_room_id\", body.matched_room_id);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
        {
            "name": "08 Get Matched Room as User 1",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{u1_access}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/rooms/{{matched_room_id}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "rooms",
                        "{{matched_room_id}}"
                    ]
                }
            },
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test(\"Room fetch returns 200\", function () {",
                            "  pm.response.to.have.status(200);",
                            "});",
                            "const body = pm.response.json();",
                            "pm.test(\"Room is random lobby\", function () {",
                            "  pm.expect(body.room_kind).to.eql(\"random\");",
                            "  pm.expect(body.status).to.eql(\"matchmaking_lobby\");",
                            "});",
                            "pm.test(\"Has at least 3 players\", function () {",
                            "  pm.expect(body.players.length).to.be.at.least(3);",
                            "});",
                            "pm.environment.set(\"fill_expires_before_u4\", body.matchmaking_fill_expires_at);"
                        ],
                        "type": "text/javascript"
                    }
                }
            ]
        },
